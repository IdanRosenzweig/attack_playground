.vscode/
.idea/

__pycache__/

# generated by start.sh - an ssh host private key must never be committed
host.key
host.key.pub

# rendered by start.sh from config.yaml - carries the gateway ip of the docker
# network on this host, which is not the same anywhere else
config.runtime.yaml

# written by the stats service (playground-stats in docker-compose.yaml): every
# session ever opened on this host. history, not source
stats_data/

.DS_Store
